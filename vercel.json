{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "data/**"
    }
  },
  "rewrites": [
    {
      "source": "/health(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/tasks(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/benchmarks(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/experiments(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/diagnostics(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/recovery(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/runs(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
