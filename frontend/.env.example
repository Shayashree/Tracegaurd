# ==============================================================================
# TraceGuard Frontend Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' inside the frontend directory if custom override is needed:
#   cp .env.example .env
#
# Note: In development with 'npm run dev', Vite proxy automatically forwards API
# requests to 'http://127.0.0.1:8000'. In production or containerized environments,
# set VITE_API_BASE_URL to the reachable public backend URL.
# ==============================================================================

VITE_API_BASE_URL=http://127.0.0.1:8000
