# ==============================================================================
# TraceGuard Environment Configuration Template
# ==============================================================================
# Instructions:
# Copy this file to '.env' in the project root to override default settings:
#   cp .env.example .env
# Never commit actual secret keys or credentials to Git.
# ==============================================================================

# Application Environment (development | testing | production)
TRACEGUARD_ENV=development

# Logging Verbosity (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# Networking & Server Configuration
API_HOST=127.0.0.1
API_PORT=8000

# CORS Allowed Origins (Comma-separated or JSON list for multi-origin production setup)
# CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Agent Execution Limits (Upper bounds on single-task steps and runtime)
DEFAULT_MAX_STEPS=8
DEFAULT_TIMEOUT_SECONDS=30.0

# Persistent SQLite Storage Paths
# (In containerized environments, point to a mounted persistent volume like /app/data/traceguard.db)
DATABASE_PATH=traceguard.db
DATA_DIR=./data

# Autonomous Recovery Safety Budgets (Milestones 4 & 7)
RECOVERY_BUDGET_MAX_ATTEMPTS=2
RECOVERY_BUDGET_MAX_STEPS=5
RECOVERY_BUDGET_MAX_TOOLS=5

# Model Adapter Configuration
# Supported adapters:
#   'mock'   - Deterministic local offline fixture model (zero API keys required, recommended for tests & reviews)
#   'openai' - Live OpenAI-compatible LLM endpoint
MODEL_ADAPTER=mock

# Live Model Credentials (Required ONLY when MODEL_ADAPTER=openai; keep commented otherwise)
# OPENAI_API_KEY=sk-placeholder-do-not-commit-real-keys
# OPENAI_MODEL_NAME=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
