# TraceGuard Configuration Example
# Copy to .env and adjust values as needed

# Application Settings
TRACEGUARD_ENV=development
LOG_LEVEL=INFO

# Agent Execution Limits
DEFAULT_MAX_STEPS=8
DEFAULT_TIMEOUT_SECONDS=30.0

# Database & Data Paths
DATABASE_PATH=traceguard.db
DATA_DIR=./data

# Model Configuration
# Options: 'mock' (default, zero credentials) or 'openai'
MODEL_ADAPTER=mock

# Optional LLM API Configuration (Used only when MODEL_ADAPTER=openai)
# OPENAI_API_KEY=your_api_key_here
# OPENAI_MODEL_NAME=gpt-4o-mini
